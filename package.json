{
  "name": "modular-chess",
  "version": "2.5.0",
  "description": "Multiplayer Chess with AI",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "server": "node server.js",
    "test": "jest",
    "build:css": "npx @tailwindcss/cli -i css/input.css -o css/output.css --minify",
    "build:mobile": "node build-mobile.js"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "express": "^4.18.2",
    "socket.io": "^4.7.2"
  },
  "devDependencies": {
    "assemblyscript": "^0.28.17",
    "electron": "^30.0.1",
    "electron-builder": "^24.13.3",
    "jest": "^29.7.0",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.3.1"
  },
  "build": {
    "appId": "com.alexanderstarchenko.modularchess",
    "win": {
      "target": "portable"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "**/*",
      "!release/**/*",
      "!node_modules/electron/**/*",
      "!node_modules/electron-builder/**/*"
    ]
  }
}
